# Configuración del Servidor
PORT=3001
NODE_ENV=development

# En el servidor de producción: HOST=127.0.0.1 (solo Caddy llega a Node).
# En desarrollo se deja vacío (0.0.0.0) para probar desde el teléfono.
HOST=

# CORS: en producción el juego y el socket van en el mismo dominio y no hace
# falta. Solo si el cliente se sirve desde OTRO dominio, ponerlo aquí.
CORS_ORIGIN=

# Debug (activar logs de depuración)
DEBUG=false

# Panel de administrador (client/#/admin) — define una clave propia;
# sin ADMIN_TOKEN el panel queda deshabilitado.
ADMIN_TOKEN=
