# Pegar al final de /etc/caddy/Caddyfile y luego: sudo systemctl reload caddy
#
#   ludoenergia.com          → sitio (site/dist)
#   ludoenergia.com/taji/    → juego TAJI (client/dist), PWA
#   ludoenergia.com/socket.io → Node (taji.service, 127.0.0.1:3001)
#
# El segundo juego, cuando exista, sería otro `handle_path /<nombre>/*` igual
# al de TAJI.

ludoenergia.com {
	encode zstd gzip

	# Tiempo real del juego (WebSocket). Caddy lo pasa tal cual.
	handle /socket.io/* {
		reverse_proxy 127.0.0.1:3001
	}

	handle /health {
		reverse_proxy 127.0.0.1:3001
	}

	# /taji sin diagonal rompería las rutas relativas del manifiesto de la PWA
	redir /taji /taji/ 308

	handle_path /taji/* {
		root * /opt/taji/client/dist

		# JS/CSS con hash en el nombre: nunca cambian, caché de un año
		@hash path_regexp ^/assets/index-[^/]+\.(js|css)$
		header @hash Cache-Control "public, max-age=31536000, immutable"

		# Arte de las cartas y fondos: una semana
		@arte path /assets/cards/* /assets/plants/* /assets/backgrounds/*
		header @arte Cache-Control "public, max-age=604800"

		# HTML, manifiesto y service worker: siempre revisar, para que nadie
		# se quede con una versión vieja del juego en el teléfono
		@fresco path / /index.html /sw.js /manifest.webmanifest
		header @fresco Cache-Control "no-cache"

		# Caddy no conoce la extensión .webmanifest; sin esto sale sin tipo
		header /manifest.webmanifest Content-Type "application/manifest+json"

		try_files {path} /index.html
		file_server
	}

	handle {
		root * /opt/taji/site/dist

		@hash path_regexp ^/assets/index-[^/]+\.(js|css)$
		header @hash Cache-Control "public, max-age=31536000, immutable"

		@img path /img/*
		header @img Cache-Control "public, max-age=604800"

		@fresco path / /index.html
		header @fresco Cache-Control "no-cache"

		try_files {path} /index.html
		file_server
	}

	log {
		output file /var/log/caddy/ludoenergia.log {
			roll_size 10MB
			roll_keep 5
		}
	}
}

www.ludoenergia.com {
	redir https://ludoenergia.com{uri} permanent
}
